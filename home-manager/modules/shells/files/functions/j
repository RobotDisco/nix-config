# Frecency-based directory jump function.
# Usage: j [query]  — cd to the best frecency match for query
#        j          — print the scored history list
#
# History file: $XDG_DATA_HOME/j/history (or ~/.local/share/j/history)
# Each line: <timestamp_seconds> <visit_count> <absolute_path>
zmodload zsh/datetime

j() {
  local data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/j"
  local histfile="$data_dir/history"

  mkdir -p "$data_dir"
  [[ -f "$histfile" ]] || touch "$histfile"

  # TODO(human): implement the body of this function
  # The function should:
  # 1. If called with no args: print the history list sorted by score (highest first)
  # 2. If called with an arg ($1): find the best-matching entry in $histfile and cd to it
  #    - "best match" means: the path contains $1 as a substring AND has the highest frecency score
  #    - frecency score = visit_count * (1 / seconds_since_last_visit), or any formula you prefer
  # 3. After a successful cd, record the visit: append/update the entry for $PWD in $histfile
  #    - If the path already exists in history, increment its count and update the timestamp
  #    - If it's new, add a line with count=1 and the current timestamp
  #
  # Hints:
  # - $(date +%s) gives current unix timestamp
  # - $EPOCHSECONDS is a zsh built-in (faster, no fork)
  # - awk is your friend for parsing and rewriting the file atomically
  # - Consider writing a helper: _j_record() that handles the record-visit logic
  #   (you'd call it from both the "cd and record" path and potentially a chpwd hook)
  if [[ $# == 0 ]]; then
      sort -nr < $histfile
  elif ! grep -q "$1" $histfile; then
      echo "$EPOCHSECONDS 1 $1" >> $histfile
      cd $1
  else
      cd "$(sort -nr < $histfile | head -n 1 | cut -d' ' -f3)"
  fi
}
