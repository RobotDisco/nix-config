root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.nix]
indent_size = 2
indent_style = space
max_line_length = 80

[*.org]
# org-mode requires this
tab_width = 8
